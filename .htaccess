# Apache (cPanel / Hostinger / HostGator). Same rules live in router.php for local testing.
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS once the SSL certificate is active (remove the # from the two lines below)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www -> bare domain, so Google sees one address
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Private folders
  RewriteRule ^(inc|docs|tools|\.git)(/|$) - [F,L]

  # Friendly URLs (SEO)
  RewriteRule ^empresa-a-venda/([a-z0-9-]+)/?$ anuncio.php?slug=$1 [L,QSA]
  RewriteRule ^comprar-empresa/([a-z0-9-]+)/?$ comprar-empresa.php?cidade_path=$1 [L,QSA]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]

  # /page -> page.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

<FilesMatch "^(\.ht.*|config(\.sample)?\.php|router\.php|.*\.(sql|md|py|log))$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
